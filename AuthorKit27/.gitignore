/paper/*.lof
/paper/*.log
/paper/*.lot
/paper/*.nav
/paper/*.out
/paper/*.pdf
/paper/*.run.xml
/paper/*.snm
/paper/*.synctex.gz
/paper/*.toc
/paper/*.vrb
/paper/*.xdv
/paper/_minted-*/
