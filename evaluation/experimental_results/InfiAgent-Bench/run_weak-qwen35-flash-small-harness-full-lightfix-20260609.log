and end days\n                return duration\n            except:\n                return np.nan\n        else:\n            return np.nan\n    except:\n        return np.nan\n\n# Apply the parsing function\ndf[\'duration\'] = df[\'dates_active\'].apply(parse_duration)\n\n# Check the duration column\nprint("Duration column sample:")\nprint(df[[\'name\', \'dates_active\', \'duration\']].head(15))\nprint("\\nDuration statistics:")\nprint(df[\'duration\'].describe())\nprint("\\nMissing duration values:", df[\'duration\'].isnull().sum())\n```\n```python\n# Filter out rows with missing duration\ndf_clean = df.dropna(subset=[\'duration\', \'max_storm_cat\', \'damage_USD\'])\nprint("Cleaned dataframe shape:", df_clean.shape)\n\n# Calculate median damage\nmedian_damage = df_clean[\'damage_USD\'].median()\nprint("Median damage:", median_damage)\n\n# Split into high and low damage groups\nhigh_damage = df_clean[df_clean[\'damage_USD\'] > median_damage]\nlow_damage = df_clean[df_clean[\'damage_USD\'] <= median_damage]\n\nprint("\\nHigh damage storms:", len(high_damage))\nprint("Low damage storms:", len(low_damage))\n```\n```python\n# Calculate Pearson correlation for high damage storms\nif len(high_damage) > 2:\n    corr_high, pval_high = stats.pearsonr(high_damage[\'max_storm_cat\'], high_damage[\'duration\'])\n    print(f"High damage - Correlation (r): {corr_high:.2f}, p-value: {pval_high:.4f}")\nelse:\n    corr_high, pval_high = None, None\n    print("Not enough high damage storms for correlation")\n\n# Calculate Pearson correlation for low damage storms\nif len(low_damage) > 2:\n    corr_low, pval_low = stats.pearsonr(low_damage[\'max_storm_cat\'], low_damage[\'duration\'])\n    print(f"Low damage - Correlation (r): {corr_low:.2f}, p-value: {pval_low:.4f}")\nelse:\n    corr_low, pval_low = None, None\n    print("Not enough low damage storms for correlation")\n```\n```python\n# Determine relationship type based on criteria\ndef determine_relationship_type(r, p_value, alpha=0.05):\n    """\n    Determine relationship type:\n    - linear: p < 0.05 and |r| >= 0.4\n    - nonlinear: p < 0.05 and |r| < 0.4\n    - none: p >= 0.05\n    """\n    if p_value is None:\n        return "none"\n    \n    if p_value >= alpha:\n        return "none"\n    elif abs(r) >= 0.4:\n        return "linear"\n    else:\n        return "nonlinear"\n\n# Determine relationship types\nhigh_relationship = determine_relationship_type(corr_high, pval_high)\nlow_relationship = determine_relationship_type(corr_low, pval_low)\n\nprint(f"\\nHigh damage relationship type: {high_relationship}")\nprint(f"Low damage relationship type: {low_relationship}")\n```\nTime consumed: 0.02s\nCode output:\nExit Code: 0\nOutput: \nDuration column sample:\n        name              dates_active  duration\n0     ARLENE             April\xa019\xa0– 21       NaN\n1       BRET              June\xa019\xa0– 20       NaN\n2      CINDY              June\xa020\xa0– 23       NaN\n3       FOUR                July\xa05\xa0– 7       NaN\n4        DON              July\xa017\xa0– 18       NaN\n5      EMILY        July\xa030\xa0– August\xa01       NaN\n6   FRANKLIN             August\xa07\xa0– 10       NaN\n7       GERT            August\xa012\xa0– 17       NaN\n8     HARVEY   August\xa017\xa0– September\xa01       NaN\n9       IRMA  August\xa030\xa0– September 12       NaN\n10      JOSE          September\xa05\xa0– 22       NaN\n11     KATIA           September\xa05\xa0– 9       NaN\n12       LEE         September\xa015\xa0– 30       NaN\n13     MARIA         September\xa016\xa0– 30       NaN\n14      NATE             October\xa04\xa0– 9       NaN\n\nDuration statistics:\ncount    0.0\nmean     NaN\nstd      NaN\nmin      NaN\n25%      NaN\n50%      NaN\n75%      NaN\nmax      NaN\nName: duration, dtype: float64\n\nMissing duration values: 818\n\nTime consumed: 0.01s\nCode output:\nExit Code: 0\nOutput: \nCleaned dataframe shape: (0, 12)\nMedian damage: nan\n\nHigh damage storms: 0\nLow damage storms