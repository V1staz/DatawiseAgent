onths - need to handle month boundary\n                # Get days in the starting month\n                start_date = datetime.strptime(f"2000 {month_start} {day_start}", "%Y %B %d")\n                # Get last day of starting month\n                if month_start in [\'January\', \'March\', \'May\', \'July\', \'August\', \'October\', \'December\']:\n                    days_in_month = 31\n                elif month_start in [\'April\', \'June\', \'September\', \'November\']:\n                    days_in_month = 30\n                elif month_start == \'February\':\n                    days_in_month = 28\n                \n                # Calculate duration\n                days_remaining_in_start = days_in_month - day_start + 1\n                end_date = datetime.strptime(f"2000 {month_end} {day_end}", "%Y %B %d")\n                # Get days from start of month to end date\n                days_in_end = day_end\n                duration = days_remaining_in_start + days_in_end\n                return duration\n        else:\n            # No month in end part, assume same month\n            start_date = datetime.strptime(f"2000 {month_start} {day_start}", "%Y %B %d")\n            end_date = datetime.strptime(f"2000 {month_start} {day_end}", "%Y %B %d")\n            duration = (end_date - start_date).days + 1\n            return duration\n    except Exception as e:\n        return np.nan\n\n# Apply the function to calculate duration\ndf[\'duration\'] = df[\'dates_active\'].apply(parse_duration_v2)\n\n# Check for any NaN values in duration\nprint("Duration column NaN count:", df[\'duration\'].isna().sum())\nprint("\\nSample durations:")\nprint(df[[\'dates_active\', \'duration\']].head(20))\n```\n```markdown\nNow let me recalculate the correlation with the corrected duration values.\n```\n```python\n# Calculate median damage level\nmedian_damage = df[\'damage_USD\'].median()\nprint("Median damage level:", median_damage)\n\n# Split into high and low damage groups\ndf[\'damage_group\'] = df[\'damage_USD\'].apply(lambda x: \'high\' if x > median_damage else \'low\')\n\nhigh_damage_df = df[df[\'damage_group\'] == \'high\'].copy()\nlow_damage_df = df[df[\'damage_group\'] == \'low\'].copy()\n\nprint("\\nHigh damage group size:", len(high_damage_df))\nprint("Low damage group size:", len(low_damage_df))\n\n# Check for NaN values in max_storm_cat and duration\nprint("\\nHigh damage - max_storm_cat NaN:", high_damage_df[\'max_storm_cat\'].isna().sum())\nprint("High damage - duration NaN:", high_damage_df[\'duration\'].isna().sum())\nprint("Low damage - max_storm_cat NaN:", low_damage_df[\'max_storm_cat\'].isna().sum())\nprint("Low damage - duration NaN:", low_damage_df[\'duration\'].isna().sum())\n```\n```markdown\nNow calculate the Pearson correlation for each group with the corrected duration values.\n```\n```python\n# Function to calculate Pearson correlation and p-value\ndef calculate_correlation(group_df, name):\n    """Calculate Pearson correlation between max_storm_cat and duration"""\n    # Drop rows with NaN values in either column\n    valid_data = group_df.dropna(subset=[\'max_storm_cat\', \'duration\'])\n    \n    if len(valid_data) < 2:\n        return None, None, "none"\n    \n    x = valid_data[\'max_storm_cat\'].values\n    y = valid_data[\'duration\'].values\n    \n    # Calculate Pearson correlation\n    r, p_value = stats.pearsonr(x, y)\n    \n    # Determine relationship type\n    if p_value >= 0.05:\n        relationship_type = "none"\n    elif abs(r) >= 0.4:\n        relationship_type = "linear"\n    else:\n        relationship_type = "nonlinear"\n    \n    return r, p_value, relationship_type, len(valid_data)\n\n# Calculate for high damage group\nhigh_r, high_p, high_type, high_n = calculate_correlation(high_damage_df, "high")\nprint(f"High damage - r: {high_r}, p: {high_p}, type: {high_type}, n: {high_n}")\n\n# Calculate for low damage group\nlow_r, low_p, low_type, low_n = calculate_correlation(low_damage_df, "low")\nprint(f"Low damage - r: {low_r}, p: {low_p}, type: {low_type}, n: {low_n}")\n```\n```markdown\nNow format the output according to specifications.\n```\n```python\n# Round values according to specifications\nhigh_r_rounded = round(high_r, 2) if high_r is not None else None\nhigh_p_rounded = round(high_p, 4) if high_p is not None else None\nlow_r_rounded = round(low_r, 2) if low_r is not None else None\nlow_p_rounded = round(low_p, 4) if low_p is not None else None\n\nprint("\\nFormatted Results:")\nprint(f"High damage correlation coefficient: {high_r_rounded}")\nprint(f"High damage p-value: {high_p_rounded}")\nprint(f"High damage relationship type: {high_type}")\nprint(f"Low damage correlation coefficient: {low_r_rounded}")\nprint(f"Low damage p-value: {low_p_rounded}")\nprint(f"Low damage relationship type: {low_type}")\n```\nTime consumed: 0.02s\nCode output:\nExit Code: 0\nOutput: \nDuration column NaN count: 672\n\nSample durations:\n                dates_active  duration\n0              April\xa019\xa0– 21       NaN\n1               June\xa019\xa0– 20       NaN\n2               June\xa020\xa0– 23       NaN\n3                 July\xa05\xa0– 7       NaN\n4               July\xa017\xa0– 18       NaN\n5         July\xa030\xa0– August\xa01       3.0\n6              August\xa07\xa0– 10       NaN\n7             August\xa012\xa0– 17       NaN\n8    August\xa017\xa0– September\xa01      16.0\n9   August\xa030\xa0– September 12      14.0\n10          September\xa05\xa0– 22       NaN\n11           September\xa05\xa0– 9       NaN\n12         September\xa015\xa0– 30       NaN\n13         September\xa016\xa0– 30       NaN\n14             October\xa04\xa0– 9       NaN\n15            October\xa09\xa0– 16       NaN\n16           October 28\xa0– 29       NaN\n17            November 5\xa0– 9       NaN\n18           January\xa012\xa0– 15       NaN\n19           May\xa027\xa0– June\xa04       9.0\n\nTime consumed: 0.01s\nCode output:\nExit Code: 0\nOutput: \nMedian damage level: 75001.0\n\nHigh damage group size: 288\nLow damage group size: 530\n\nHigh damage - max_storm_cat NaN: 0\nHigh damage - duration NaN: 225\nLow damage - max_storm_cat NaN: 0\nLow damage - duration NaN: 447\n\nTime consumed: 0.01s\nCode output:\nExit Code: 0\nOutput: \nHigh damage - r: 0.4577746036514764, p: 0.00016176073131544895, type: linear, n: 63\nLow damage - r: 0.48821629652383147, p: 2.8401321455608376e-06, type: linear, n: 83\n\nTime consumed: 0.00s\nCode output:\nExit Code: 0\nOutput: \n\nFormatted Results:\nHigh damage correlation coefficient: 0.46\nHigh damage p-value: 0.0002\nHigh damage relationship type: linear\nLow damage correlation coefficient: 0.49\nLow damage p-value: 0.0\nLow damage relationship type: linear\n\n```markdown\nThe date parsing is still having issues with many NaN values. Let me try a more robust approach using pandas to parse the dates properly.\n```\n```python\nimport pandas as pd\nimport numpy as np\nfrom scipy import stats\nfrom datetime import datetime\n\n# Load the data\ndf = pd.read_csv(\'./input/cost_data_with_errors.csv\')\n\n# Try a different approach - use pandas date parsing\ndef parse_duration_v3(date_str):\n    """Parse date string like \'April 19 – 21\' and return duration in days"""\n    if pd.isna(date_str):\n        return np.nan\n    \n    date_str = str(date_str).strip()\n    \n    # Handle the em-dash separator\n    if \'–\' in date_str:\n        parts = date_str.split(\'–\')\n    elif \'-\' in date_str:\n        parts = date_str.split(\'-\')\n    else:\n        return np.nan\n    \n    if len(parts) != 2:\n        return np.nan\n    \n    start_str = parts[0].strip()\n    end_str = parts[1].strip()\n    \n    try:\n        # Try to parse using pandas\n        start_date = pd.to_datetime(start_str, format=\'%B %d\', errors=\'coerce\')\n        end_date = pd.to_datetime(end_str, format=\'%B %d\', errors=\'coerce\')\n        \n        if pd.isna(start_date) or pd.isna(end_date):\n            return np.nan\n        \n        # If months are different, we need to handle it\n        if start_date.month != end_date.month:\n            # Get days remaining in start month\n            days_in_start_month = start_date.replace(day=28) + pd.DateOffset(months=1) - start_date\n            days_remaining = (days_in_start_month.days)\n            # Add days in end month\n            days_in_end = end_date.day\n            duration = days_remaining + days_in_end\n        else:\n            duration = (end_date - start_date).days + 1\n        \n        return duration\n    except:\n        return np.nan\n\n# Apply the function to calculate duration\ndf[\'duration\'] = df[\'dates_active\'].apply(parse_duration_v3)\n\n# Check for any NaN values in duration\nprint("Duration column NaN count:", df[\'duration\'].isna().sum())\nprint("\\nSample durations:")\nprint(df[[\'dates_active\', \'duration\']].head(30))\n```\n```markdown\nLet me check the unique date formats in the data to better understand the parsing issues.\n```\n```python\n# Check unique date formats\nprint("\\nUnique date_active patterns:")\nprint(df[\'dates_active\'].unique()[:20])\n\n# Check for any patterns that might be causing issues\nprint("\\nSample of dates that failed to parse:")\nfailed_dates = df[df[\'duration\'].isna()][\'dates_active\'].head(20)\nprint(failed_dates)\n```\n```markdown\nLet me try a simpler approach - just count the number of days between start and end dates using a more flexible parsing method.\n```\n```python\nimport re\n\ndef parse_duration_v4(date_str):\n    """Parse date string and return duration in days"""\n    if pd.isna(date_str):\n        return np.nan\n    \n    date_str = str(date_str).strip()\n    \n    # Extract all numbers and month names\n    # Pattern: Month Day – Month Day (or just Day)\n    pattern = r\'([A-Za-z]+)\\s+(\\d+)\\s*[–\\-]\\s*([A-Za-z]*)\\s*(\\d+)\'\n    match = re.search(pattern, date_str)\n    \n    if not match:\n        return np.nan\n    \n    month_start = match.group(1)\n    day_start = int(match.group(2))\n    month_end = match.group(3) if match.group(3) else month_start  # Same month if not specified\n    day_end = int(match.group(4))\n    \n    try:\n        # Create date objects\n        start_date = datetime.strptime(f"{month_start} {day_start}", "%B %d")\n        end_date = datetime.strptime(f"{month_end} {day_end}", "%B %d")\n        \n        # Handle month boundary\n        if month_start != month_end:\n            # Get days in start month\n            month_days = {\n                \'January\': 31, \'February\': 28, \'March\': 31, \'April\': 30,\n                \'May\': 31, \'June\': 30, \'July\': 31, \'August\': 31,\n                \'September\': 30, \'October\': 31, \'November\': 30, \'December\': 31\n            }\n            days_in_start = month_days.get(month_start, 30)\n            days_remaining = days_in_start - day_start + 1\n            duration = days_remaining + day_end\n        else:\n            duration = day_end - day_start + 1\n        \n        return duration\n    except:\n        return np.nan\n\n# Apply the function to calculate duration\ndf[\'duration\'] = df[\'dates_active\'].apply(parse_duration_v4)\n\n# Check for any NaN values in duration\nprint("Duration column NaN count:", df[\'duration\'].isna().sum())\nprint("\\nSample durations:")\nprint(df[[\'dates_active\', \'duration\']].head(30))\n```\n```markdown\nNow recalculate the correlation with the corrected duration values.\n```\n```python\n# Calculate median damage level\nmedian_damage = df[\'damage_USD\'].median()\nprint("Median damage level:", median_damage)\n\n# Split into high and low damage groups\ndf[\'damage_group\'] = df[\'damage_USD\'].apply(lambda x: \'high\' if x > median_damage else \'low\')\n\nhigh_damage_df = df[df[\'damage_group\'] == \'high\'].copy()\nlow_damage_df = df[df[\'damage_group\'] == \'low\'].copy()\n\nprint("\\nHigh damage group size:", len(high_damage_df))\nprint("Low damage group size:", len(low_damage_df))\n\n# Check for NaN values in max_storm_cat and duration\nprint("\\nHigh damage - max_storm_cat NaN:", high_damage_df[\'max_storm_cat\'].isna().sum())\nprint("High damage - duration NaN:", high_damage_df[\'duration\'].isna().sum())\nprint("Low damage - max_storm_cat NaN:", low_damage_df[\'max_storm_cat\'].isna().sum())\nprint("Low damage - duration NaN:", low_damage_df[\'duration\'].isna().sum())\n```\n```markdown\nNow calculate the Pearson correlation for each group with the corrected duration values.\n```\n```python\n# Function to calculate Pearson correlation and p-value\ndef calculate_correlation(group_df, name):\n    """Calculate Pearson correlation between max_storm_cat and duration"""\n    # Drop rows with NaN values in either column\n    valid_data = group_df.dropna(subset=[\'max_storm_cat\', \'duration\'])\n    \n    if len(valid_data) < 2:\n        return None, None, "none"\n    \n    x = valid_data[\'max_storm_cat\'].values\n    y = valid_data[\'duration\'].values\n    \n    # Calculate Pearson correlation\n    r, p_value = stats.pearsonr(x, y)\n    \n    # Determine relationship type\n    if p_value >= 0.05:\n        relationship_type = "none"\n    elif abs(r) >= 0.4:\n        relationship_type = "linear"\n    else:\n        relationship_type = "nonlinear"\n    \n    return r, p_value, relationship_type, len(valid_data)\n\n# Calculate for high damage group\nhigh_r, high_p, high_type, high_n = calculate_correlation(high_damage_df, "high")\nprint(f"High damage - r: {high_r}, p: {high_p}, type: {high_type}, n: {high_n}")\n\n# Calculate for low damage group\nlow_r, low_p, low_type, low_n = calculate_correlation(low_damage_df, "low")\nprint(f"Low damage - r: {low_r}, p: {low_p}, type: {low_type}, n: {low_n}")\n```\n```markdown\nNow format the output according to specifications.\n```\n```python\n# Round values according to specifications\nhigh_r_rounded = round(high_r, 2) if high_r is not None else None\nhigh_p_rounded = round(high_p, 4) if high_p is not None e