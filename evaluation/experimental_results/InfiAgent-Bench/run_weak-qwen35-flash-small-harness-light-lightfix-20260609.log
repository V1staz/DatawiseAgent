ucation column\neducation_mode = df[\'Education\'].mode()[0]\nprint(f"Education Mode: {education_mode}")\n\n# Get min and max values for Income and Balance before normalization\nincome_min = df[\'Income\'].min()\nincome_max = df[\'Income\'].max()\nbalance_min = df[\'Balance\'].min()\nbalance_max = df[\'Balance\'].max()\n\nprint(f"Income - Min: {income_min}, Max: {income_max}")\nprint(f"Balance - Min: {balance_min}, Max: {balance_max}")\n\n# Apply Min-Max normalization to Income column\ndf[\'Income_normalized\'] = (df[\'Income\'] - income_min) / (income_max - income_min)\n\n# Apply Min-Max normalization to Balance column\ndf[\'Balance_normalized\'] = (df[\'Balance\'] - balance_min) / (balance_max - balance_min)\n\n# Save the normalized files\nincome_normalized_path = \'./working/income_normalized.csv\'\nbalance_normalized_path = \'./working/balance_normalized.csv\'\n\n# Save only the normalized columns for each file\ndf_income_normalized = df[[\'Income_normalized\']].to_csv(income_normalized_path, index=False)\ndf_balance_normalized = df[[\'Balance_normalized\']].to_csv(balance_normalized_path, index=False)\n\nprint(f"Income normalized file saved to: {income_normalized_path}")\nprint(f"Balance normalized file saved to: {balance_normalized_path}")\n\n# Round min and max values to 2 decimal places\nincome_min_rounded = round(income_min, 2)\nincome_max_rounded = round(income_max, 2)\nbalance_min_rounded = round(balance_min, 2)\nbalance_max_rounded = round(balance_max, 2)\n\nprint(f"\\nRounded values:")\nprint(f"Income - Min: {income_min_rounded}, Max: {income_max_rounded}")\nprint(f"Balance - Min: {balance_min_rounded}, Max: {balance_max_rounded}")\n```\nTime consumed: 0.02s\nCode output:\nExit Code: 0\nOutput: \nEducation Mode: 16\nIncome - Min: 10.354, Max: 186.634\nBalance - Min: 0, Max: 1999\nIncome normalized file saved to: ./working/income_normalized.csv\nBalance normalized file saved to: ./working/balance_normalized.csv\n\nRounded values:\nIncome - Min: 10.35, Ma